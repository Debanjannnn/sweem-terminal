# ── chain ────────────────────────────────────────────────────────────────
# no bare MONAD_RPC_URL: a service must never read the wrong network by accident
CHAIN_ID=10143
MONAD_RPC_URL_143=https://rpc.monad.xyz
MONAD_RPC_URL_10143=https://testnet-rpc.monad.xyz

# ── privy ────────────────────────────────────────────────────────────────
PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_APP_ID=
# executor only. wallet refuses to boot if it can see these.
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_PRIVATE_KEY=
# key quorum wrapping the authorization key; the client passes this to addSigners
PRIVY_KEY_QUORUM_ID=
NEXT_PUBLIC_PRIVY_SIGNER_ID=
PRIVY_POLICY_ID=
NEXT_PUBLIC_PRIVY_POLICY_ID=
# GET /v1/apps/{id} is undocumented/legacy; set this to skip it
PRIVY_VERIFICATION_KEY=

# ── venues ───────────────────────────────────────────────────────────────
KURU_API_URL=https://api.testnet.kuru.io/api/v1
# kuru contracts are ERC-1967 proxies. resolve the implementation before use.
KURU_ROUTER=0x7EFbE105Ca7415dE98F96622173458ac1c054630
KURU_MARGIN_ACCOUNT=0xd029C2D98ff85D8F64799017fE00a59B1159CE02
# kuru's own testnet USDC. other "testnet USDC" tokens exist and are NOT interchangeable.
KURU_QUOTE_TOKEN=0xee0722ead54f1b4fe97be399be43bc0226a6f97e
# the documented router is NOT paired with the live markets (verifiedMarket -> false,
# anyToAnySwap reverts InvalidMarket). override once the real address is known.
# indexer needs a YAML flow list, not a bare comma list:
KURU_MARKETS=["0x5bdea6f9f9aba34f4ecb9b865646a792b835ef7f","0xa9c2936656a7d2143720bcd91ba8506200b7cbe7","0xfdbe356828c8f5a5d5ed4f69dde0816f4058ef61","0x0b4dd2a7b09d5c5401149ffe51301cc589017343"]

PERPL_API_URL=https://testnet.perpl.xyz/api
PERPL_WS_URL=wss://testnet.perpl.xyz
PERPL_EXCHANGE_ADDRESS=0x1964c32f0be608e7d29302aff5e61268e72080cc
# market ids and collateral differ per network. resolve at runtime from /v1/pub/context.

# ── oracle ───────────────────────────────────────────────────────────────
ORACLE_PRICE_SOURCE=pyth
# pyth is a pull oracle: freshness is per-chain. testnet is ~68h stale, mainnet ~5s.
# always read from mainnet regardless of the chain we trade on.
PYTH_READ_CHAIN_ID=143
PYTH_CONTRACT=0x2880aB155794e7179c9eE2e38200202908C17B43
PYTH_FEED_ETH_USD=0xff61491a931112ddf1bd8147cd1b641375f79f5825126d665480874634fd0ace
PYTH_FEED_MON_USD=0x31491744e2dbf6df7fcf4ac0820d18a609b49076d45066d3568424e62f686cd1
PYTH_FEED_BTC_USD=0xe62df6c8b4a85fe1a67db44dc12de5db330f7ac66b72dc658afedf0f4a415b43
CHAINLINK_ETH_USD_10143=0x5c8c8482f064049248F86D9F4aFa4B1f2F5b6d31
ORACLE_SAMPLE_INTERVAL_MS=15000
ORACLE_STALE_MS=60000
ORACLE_LAMBDA=0.94
ORACLE_WARMUP_SAMPLES=30
ORACLE_POWER_EXPONENTS=2,0.5
ORACLE_MAX_DEVIATION=0.10

# ── contracts (filled by contracts/script/Deploy.s.sol) ──────────────────
INDEX_PERP_ENGINE=
MARKET_REGISTRY=
SWEEM_VAULT=
SUSD=
VOL_INDEX_ORACLE=
POWER2_INDEX_ORACLE=
POWER_HALF_INDEX_ORACLE=

# ── infra ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://sweem:sweem@localhost:5433/sweem?sslmode=disable
REDIS_URL=redis://localhost:6380
NATS_URL=nats://localhost:4222
INDEXER_URL=http://localhost:8090/v1/graphql
HASURA_EXTERNAL_PORT=8090
# required. hypersync /query is 401 unauthenticated, there is no degraded mode.
ENVIO_API_TOKEN=
# host ports only; containers still talk on 5432/6379 internally
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
LOG_LEVEL=info

# ── service wiring ───────────────────────────────────────────────────────
WALLET_URL=http://localhost:8080
MARKET_DATA_URL=http://localhost:8081
EXECUTOR_URL=http://localhost:8083
NEXT_PUBLIC_WALLET_URL=http://localhost:8080
NEXT_PUBLIC_MARKET_DATA_URL=http://localhost:8081
NEXT_PUBLIC_MARKET_DATA_WS_URL=ws://localhost:8082
CORS_ORIGINS=http://localhost:3000
# scheduler -> wallet, acting as a user without a JWT
INTERNAL_SECRET=

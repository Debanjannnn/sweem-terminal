# copy to .env (shared, non-signing) and .env.executor (signer secrets). both gitignored.
RPC_URL=https://rpc.monad.xyz
CHAIN_ID=143
# compose overrides to /deployments/143.json
DEPLOYMENTS_PATH=contracts/deployments/143.json
LOG_LEVEL=info

# host-side urls; compose rewrites these to service names
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
DATABASE_URL=postgres://sweem:sweem@localhost:5433/sweem?sslmode=disable
REDIS_URL=redis://localhost:6380
EXECUTOR_URL=http://localhost:8083

KURU_WS_URL=wss://exchange.kuru.io/ws
KURU_API_URL=https://exchange.kuru.io

# openssl rand -hex 24; must match in .env and .env.executor
INTERNAL_SECRET=

PRIVY_APP_ID=
PRIVY_KEY_QUORUM_ID=
PRIVY_POLICY_ID=

ENVIO_API_TOKEN=

# ---- prod (docker-compose.prod.yml) ----
# Caddy serves api.$DOMAIN, data.$DOMAIN, history.$DOMAIN; A records → server IP
DOMAIN=
# client origin, e.g. https://sweem.xyz
CORS_ORIGINS=

# ---- .env.executor (signer secrets); PRIVY_APP_SECRET + MAX_STEP_USD also in .env.api ----
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_PRIVATE_KEY=
# per-step stablecoin cap in USD; api (planner) and executor must match
MAX_STEP_USD=

# ---- payout CLI only (go run ./services/api/cmd/payout --send); never in a service env ----
TREASURY_PRIVATE_KEY=

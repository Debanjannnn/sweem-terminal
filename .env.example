# copy to .env (shared, non-signing) and .env.executor (signer secrets). both gitignored.
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
# compose overrides to /deployments/10143.json
DEPLOYMENTS_PATH=contracts/deployments/10143.json
LOG_LEVEL=info

# host-side urls; compose rewrites these to service names
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
DATABASE_URL=postgres://sweem:sweem@localhost:5433/sweem?sslmode=disable
REDIS_URL=redis://localhost:6380
EXECUTOR_URL=http://localhost:8083

KURU_GATEWAY_WS_URL=wss://gateway.testnet.kuru.io/ws
KURU_API_URL=https://api.testnet.kuru.io

# openssl rand -hex 24; must match in .env and .env.executor
INTERNAL_SECRET=

PRIVY_APP_ID=
PRIVY_KEY_QUORUM_ID=
PRIVY_POLICY_ID=

ENVIO_API_TOKEN=

# ---- .env.executor only ----
# PRIVY_APP_SECRET=
# PRIVY_AUTHORIZATION_PRIVATE_KEY=
# BOT_PRIVATE_KEY=

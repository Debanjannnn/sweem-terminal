# Documents the vars only. Real values live in main/.env; indexer/.env is a
# symlink to it, because envio loads .env from its own cwd:
#   ln -s ../.env .env
# Full walkthrough: SETUP.md.

# HARD REQUIREMENT, not a rate limit. monad-testnet.hypersync.xyz/query answers
# unauthenticated calls with 401 and src/handlers/preflight.ts refuses to start
# without it. A HyperRPC token is NOT accepted here (403).
# Create one at https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=

# Defaults to 58777816, the Kuru AccountCore deployment. Our own contracts land
# later, so one start block covers everything. Lowering it only rescans.
ENVIO_START_BLOCK=

# Shared with the rest of main/.env — filled by contracts/script/Deploy.s.sol.
# Until these are set the indexer starts and matches nothing (zero address).
SWEEM_VAULT=
MARKET_REGISTRY=
INDEX_PERP_ENGINE=
# IndexOracle is NOT here: one contract per feed, all discovered from MarketAdded.

# Kuru Spot V2. Both default to the live testnet deployment, so leaving these
# blank is the normal case; set them only to pin a different deployment.
# AccountCore holds every balance — the orderbooks never hold tokens.
# KURU_MARKETS is a YAML flow list of quoted addresses: this is a textual
# substitution into config.yaml, so a bare comma list fails codegen with
# "invalid address".
KURU_ACCOUNT_CORE=0x6384e9b2Bf3b65e1535403a0A543b5FDA905eE22
KURU_MARKETS=["0x5BDEA6F9F9abA34F4EcB9B865646A792b835ef7f","0xa9C2936656a7D2143720BcD91Ba8506200B7CbE7","0xfdbE356828c8f5A5d5ed4f69ddE0816f4058Ef61","0x0B4dD2A7b09d5c5401149fFe51301Cc589017343"]

# Registry only, and the trading wallet's logs carry the delegated EOA as their
# address rather than this one. Neither is indexed; see SETUP.md §6.
# KURU_SPOT_ROUTER=0xba24a1042701f06e8F7edCF04389260D1Fa4c697
# KURU_TRADING_WALLET=0xc7f2a9761276F7050D6561d2FDC51abC993F45E9

# GraphQL playground / API port. 8090 because wallet owns 8080.
HASURA_EXTERNAL_PORT=8090

# DO NOT SET. `bun run test` sets ENVIO_BLOCK_LAG=0 because the test framework's
# synthetic block source never advances past the last simulated block.
# Production must run at the config default of 5 (FINALITY_DEPTH).
# ENVIO_BLOCK_LAG=

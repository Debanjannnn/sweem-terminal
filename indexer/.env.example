# Documents the vars only. Real values live in main/.env; indexer/.env is a
# symlink to it, because envio loads .env from its own cwd:
#   ln -s ../.env .env
# Full walkthrough: SETUP.md.

# HARD REQUIREMENT, not a rate limit. monad-testnet.hypersync.xyz/query answers
# unauthenticated calls with 401 and src/handlers/preflight.ts refuses to start
# without it. A HyperRPC token is NOT accepted here (403).
# Create one at https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=

# Deployment block. Defaults to 0, which is correct but rescans the chain.
ENVIO_START_BLOCK=

# Shared with the rest of main/.env — filled by contracts/script/Deploy.s.sol.
# Until these are set the indexer starts and matches nothing (zero address).
SWEEM_VAULT=
MARKET_REGISTRY=
INDEX_PERP_ENGINE=
# IndexOracle is NOT here: one contract per feed, all discovered from MarketAdded.

# Kuru OrderBook proxies, one per spot market. YAML flow list, quoted addresses
# — this is a textual substitution into config.yaml, so a bare comma list fails
# codegen with "invalid address".
KURU_MARKETS=["0x0000000000000000000000000000000000000000"]

# GraphQL playground / API port. 8090 because wallet owns 8080.
HASURA_EXTERNAL_PORT=8090

# DO NOT SET. `bun run test` sets ENVIO_BLOCK_LAG=0 because the test framework's
# synthetic block source never advances past the last simulated block.
# Production must run at the config default of 5 (FINALITY_DEPTH).
# ENVIO_BLOCK_LAG=
